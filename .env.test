# Loaded automatically by `bun test` (which sets NODE_ENV=test) and overrides .env.
# Points the suite at the throwaway test DB and disables caching so the integration
# tests don't pollute one another. setup.ts additionally refuses to run unless it's
# actually connected to `dataindex_test` (see assertTestDb), so this is convenience,
# not the safety net.
DATABASE_URL=postgresql://test:test@localhost:5434/dataindex_test
CACHE_TTL_MINUTES=0

# Base/display resolution the suite's assertions are written against — pinned here so
# the tests run at fixed, visible values and a change to a production default in
# packages/shared/src/config never breaks them.
PRECOMP_TIME_BIN_YEARS=10
PRECOMP_GRID_CELL_METERS=100
DISPLAY_TIME_BIN_MIN_YEARS=10
DISPLAY_TIME_BIN_MAX_YEARS=100
