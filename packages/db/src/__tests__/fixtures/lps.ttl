# Test fixture: a real subset of 20230920-lps.ttl (Adamlink linked points / LP geometry).
#
# Each allp: subject is one LP point; the lps ingestion creates a `place` row
# (id = the allp URI, type = address) from the allp URI + geo:asWKT geometry (WGS84,
# reprojected to RD on insert). The schema:geoWithin links (addresses, BAG building)
# are not used by the ingestion. Regenerated by build.py — do not edit by hand.
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <https://schema.org/> .
@prefix bagpand: <http://bag.basisregistraties.overheid.nl/bag/id/pand/> .
@prefix aladr: <https://adamlink.nl/geo/address/> .
@prefix allp: <https://adamlink.nl/geo/lp/> .

allp:1019888
	a schema:GeospatialGeometry, geo:Geometry ;
	schema:geoWithin aladr:A88747, aladr:A88748, aladr:A88749, aladr:A88750, aladr:A88751 ;
	schema:geoWithin bagpand:0363100012182332 ;
	geo:asWKT "POINT(4.8997238 52.3707968)"^^geo:wktLiteral .

allp:1040232
	a schema:GeospatialGeometry, geo:Geometry ;
	schema:geoWithin aladr:A148564, aladr:A148565 ;
	geo:asWKT "POINT(4.9160736 52.3572543)"^^geo:wktLiteral .

allp:1053981
	a schema:GeospatialGeometry, geo:Geometry ;
	schema:geoWithin aladr:A173486 ;
	schema:geoWithin bagpand:0363100012137497 ;
	geo:asWKT "POINT(4.8719883 52.3477579)"^^geo:wktLiteral .

allp:1105213
	a schema:GeospatialGeometry, geo:Geometry ;
	schema:geoWithin aladr:A225770 ;
	schema:geoWithin bagpand:0363100012088363 ;
	geo:asWKT "POINT(4.9135313 52.3593529)"^^geo:wktLiteral .

allp:1105239
	a schema:GeospatialGeometry, geo:Geometry ;
	schema:geoWithin aladr:A225796 ;
	schema:geoWithin bagpand:0363100012125707 ;
	geo:asWKT "POINT(4.9109832 52.3591811)"^^geo:wktLiteral .
