{
	"name": "@atm/app",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "bun --bun --env-file=../../.env vite dev --port 5175",
		"build": "bun --bun --env-file=../../.env vite build",
		"preview": "bun --bun --env-file=../../.env vite preview",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write \"src/**/*.{js,ts,svelte}\""
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "^1.0.2",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.4.5",
		"@types/lodash.debounce": "^4.0.9",
		"autoprefixer": "^10.7.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"phosphor-svelte": "^3.1.1",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"type": "module",
	"dependencies": {
		"@atm/shared": "workspace:*",
		"clsx": "^2.1.1",
		"lodash.debounce": "^4.0.8",
		"maplibre-gl": "^6.19.0",
		"melt": "^0.44.0",
		"proj4": "^2.23.0",
		"tailwind-merge": "^2.6.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
