{
  "name": "@atm/flagship",
  "private": true,
  "engines": {
    "bun": "latest"
  },
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@atm/app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "build:app": "turbo run build --filter=@atm/app",
    "clean": "turbo run clean",
    "db:migrate": "cd packages/db && bunx drizzle-kit migrate",
    "db:generate": "cd packages/db && bunx drizzle-kit generate",
    "db:ingest": "cd packages/db && bun run src/etl/index.ts ingest",
    "db:rebuild-cells": "cd packages/db && bun run src/etl/index.ts rebuild-cells",
    "db:studio": "cd packages/db && bun run db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up",
    "docker:up:build": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:logs:app": "docker compose -f docker/docker-compose.yml logs -f app",
    "docker:restart": "docker compose -f docker/docker-compose.yml restart",
    "docker:restart:app": "docker compose -f docker/docker-compose.yml restart app"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
