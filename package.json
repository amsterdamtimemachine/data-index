{
  "name": "@atm/flagship",
  "private": true,
  "engines": {
    "bun": "latest"
  },
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@atm/app",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "build:app": "turbo run build --filter=@atm/app",
    "clean": "turbo run clean",
    "db:migrate": "bunx drizzle-kit migrate --config=packages/db/drizzle.config.ts",
    "db:generate": "bunx drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:push-schema": "bunx drizzle-kit push --config=packages/db/drizzle.config.ts",
    "db:ingest": "bun run packages/db/src/etl/index.ts ingest",
    "db:rebuild-index": "bun run packages/db/src/etl/index.ts rebuild-index",
    "db:studio": "bunx drizzle-kit studio --config=packages/db/drizzle.config.ts",
    "test": "turbo run test",
    "test:unit": "cd packages/db && bun test src/queries/__tests__",
    "test:integration": "cd packages/db && DATABASE_URL=postgresql://test:test@localhost:5434/dataindex_test CACHE_TTL_MINUTES=0 bun test src/__tests__",
    "test:db:up": "docker compose -f docker/docker-compose.test.yml up -d && sleep 2",
    "test:db:down": "docker compose -f docker/docker-compose.test.yml down -v",
    "docker:db:up": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml up -d dataindex-db",
    "docker:db:down": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml down",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml up",
    "docker:up:build": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml up --build",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml down",
    "docker:logs": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml logs -f",
    "docker:logs:app": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml logs -f app",
    "docker:restart": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml restart",
    "docker:restart:app": "docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.self-hosted.yml restart app"
  },
  "devDependencies": {
    "turbo": "^2.9.18"
  },
  "overrides": {
    "protocol-buffers-schema": "3.6.1"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.66.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "n3": "^2.0.4",
    "pg": "^8.22.0",
    "prettier": "^3.8.4",
    "proj4": "^2.20.9",
    "svelte": "^5.56.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
