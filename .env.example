#####################
### database ###
#####################

DB_USER=atm
DB_PASSWORD=atm_dev_password
DATABASE_URL=postgresql://atm:atm_dev_password@localhost:5432/amsterdam_time_machine

#####################
### sveltekit app ###
#####################

# MapTiler API key - get one from https://www.maptiler.com/
PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# Default cell to select when no URL parameters are provided
PUBLIC_DEFAULT_CELL=98_80

#####################
### geographic bounds ###
#####################

BOUNDS_MIN_LON=4.69
BOUNDS_MAX_LON=5.12
BOUNDS_MIN_LAT=52.24
BOUNDS_MAX_LAT=52.49
