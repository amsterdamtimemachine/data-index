#####################
### database ###
#####################

DB_USER=atm
DB_PASSWORD=atm_dev_password
DB_NAME=amsterdam_time_machine
DB_HOST=localhost
DB_PORT=5432

#####################
### data processing ###
#####################

# Base time bin size for temporal frequency computation (years)
BASE_BIN_SIZE=10 # years
# Cell size for pre-computed spatial grid (meters)
# CELL_SIZE_METERS=100

#####################
### heatmap grid ###
#####################

# Display grid resolution defaults and bounds
# GRID_DEFAULT=75
# GRID_MIN=10
# GRID_MAX=200

#####################
### time bins ###
#####################

# Display bin size defaults and bounds (years)
# DEFAULT_BIN_SIZE=50
# BIN_SIZE_MIN=10
# BIN_SIZE_MAX=100

#####################
### cache ###
#####################

# TTL for cached DB queries (minutes)
CACHE_TTL_MINUTES=10 # minutes

#####################
### sveltekit app ###
#####################

# Host port the app container binds to (container always listens on 3000 internally)
# APP_PORT=3000

# Default cell to select when no URL parameters are provided
PUBLIC_DEFAULT_CELL=98_80

# Vector tile source URL (defaults to OpenFreeMap if not set)
# PUBLIC_TILE_SOURCE_URL=https://tiles.openfreemap.org/planet
