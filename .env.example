#
####################
### compose ###
#####################

# Names this deployment's containers, network and volumes. Compose otherwise derives
# the project name from docker/, so two deployments on one host would collide.
# Use a distinct value per deployment, e.g. data-index-prod / data-index-staging.
COMPOSE_PROJECT_NAME=data-index

# NOTE: never put '#' inside a value below. Compose keeps `pa#ss` whole while Bun
# truncates it to `pa`, so a password containing one is set correctly on the database
# and silently wrong everywhere else — surfacing much later as an authentication
# failure nowhere near the cause.

#####################
### database ###
#####################

DB_USER=atm
DB_PASSWORD=atm_dev_password
DB_NAME=amsterdam_time_machine
DB_HOST=localhost
# DB_PORT=5432

# Connection pool timeouts (ms). statement_timeout is the backstop that kills a
# runaway query; keep it generous enough for ETL (rebuild-index) if that shares this env.
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=30000

#####################
### precomputed index — changing these needs `db:rebuild-index` ###
#####################

# These shape what rebuild-index bakes into place_cells / cell_features. They are the
# finest grain the map can show; display settings below only aggregate them. Change
# either and the stored buckets must be rebuilt, or counts go quietly wrong.

# Base spatial cell size (metres).
# PRECOMP_GRID_CELL_METERS=100
# Base time bin size (years). Caps display bin size to multiples of this.
PRECOMP_TIME_BIN_YEARS=50

# Feature→place link distance caps (metres): how far a feature's coordinate may sit
# from an address / street before it won't link. Areas link by containment (no radius).
# ADDRESS_MAX_DISTANCE_M=30
# STREET_MAX_DISTANCE_M=50

# Era anchors for feature→place resolution. ERA_CUTOFF: the address adamlink(historical)↔
# bag(present) boundary. CURRENT_ANCHOR: present-day reference for scoring current names.
# ERA_CUTOFF=1943-01-01
# CURRENT_ANCHOR=2020-01-01

#####################
### display resolution — restart only, no rebuild ###
#####################

# How a request aggregates the precomputed base cells/bins for rendering. Bounds clamp
# the values a client may request; defaults apply when it requests none.

# Heatmap grid width in columns (rows follow the data's aspect ratio).
DISPLAY_GRID_DEFAULT_COLS=125
# DISPLAY_GRID_MIN_COLS=10
# DISPLAY_GRID_MAX_COLS=200

# Timeline/histogram bin size in years (snapped down to a multiple of PRECOMP_TIME_BIN_YEARS).
# DISPLAY_TIME_BIN_DEFAULT_YEARS=50
# DISPLAY_TIME_BIN_MIN_YEARS=10
# DISPLAY_TIME_BIN_MAX_YEARS=100

# Experimental: reproject heatmap cells to their true RD/28992 footprint (proj4)
# instead of axis-aligned lon/lat rectangles — removes the ~0.4° rotation skew.
# PUBLIC_EXACT_CELLS=true

#####################
### api request limits ###
#####################

# Feature list pagination and filter caps (server-side validation)
# DEFAULT_PAGE_SIZE=50
# PAGE_SIZE_MAX=200
# MAX_FILTER_ITEMS=50   # max items per comma-separated filter (tags, datasets, …)

#####################
### cache ###
#####################

# TTL for cached DB queries (minutes)
# CACHE_TTL_MINUTES=10

#####################
### sveltekit app ###
#####################

# Host port the app container binds to (container always listens on 3000 internally)
# APP_PORT=3000

# Default cell to select when no URL parameters are provided
PUBLIC_DEFAULT_CELL=98_80

# Vector tile source URL (defaults to OpenFreeMap if not set)
# PUBLIC_TILE_SOURCE_URL=https://tiles.openfreemap.org/planet
