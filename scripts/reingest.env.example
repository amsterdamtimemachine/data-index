# Settings for the reingest scripts: copy to scripts/reingest.env and edit for this machine.
# Only DATA is required; set a file name only when yours differs from the default.

# absolute path of the directory holding the source files
DATA=/srv/atm-data

# Adamlink places
# BUURTEN=adamlinkbuurten.ttl
# STRATEN=adamlinkstraten.ttl
# LPS=lps.ttl
# ADRESSEN=adressen.ttl
# GEBOUWEN=adamlinkgebouwen.ttl

# feature datasets
# BEELDBANK=beeldbank.csv
# JM=results_jm.csv
# DELPHER=delpher_newspapers.csv
# CINEMA=cinema-context.jsonl
# DIARIES=amsterdam-diaries.jsonl

# dumps CINEMA and DIARIES are extracted from when those files are missing
# CINEMA_DUMP=cinema-context.sql
# DIARIES_DUMP=amsterdam-diaries-dump

# classifier tags (optional), one file per dataset, and the models that made them
# TAGS_BEELDBANK=beeldbank-tags.jsonl
# TAGS_DELPHER=delpher-tags.jsonl
# TAGS_DIARIES=amsterdam-diaries-tags.jsonl
# IMAGE_TAGGER=google/siglip2-base-patch16-224
# IMAGE_TAGGER_LABEL=google/siglip2-base-patch16-224
# IMAGE_TAGGER_URL=https://huggingface.co/google/siglip2-base-patch16-224
# TEXT_TAGGER=BAAI/bge-m3
# TEXT_TAGGER_LABEL=BAAI/bge-m3
# TEXT_TAGGER_URL=https://huggingface.co/BAAI/bge-m3
